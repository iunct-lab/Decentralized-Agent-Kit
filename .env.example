# ==============================================
# LLM Configuration
# ==============================================
# Model selection (LiteLLM format): a Gemini model, openai/gpt-5.6-luna,
# anthropic/claude-..., ollama/llama3.2,
# bedrock/... (model IDs: docs/getting-started/bedrock.md)
# Optional: delete the line to use the agent's built-in default. The value
# below mirrors that default (agent/dak_agent/config.py DEFAULT_MODEL_NAME; a
# unit test keeps the two equal). It runs on the AI Studio free tier with a
# GOOGLE_API_KEY (paid: $0.75/$3.75 per 1M tok through 2026-12-31). The free
# tier's daily request quota is small; for heavier free use switch to
# gemini-3.5-flash-lite. Switching models is an env change, never a code change.
MODEL_NAME=gemini-3.8-flash

# API Keys (at least one, matching MODEL_NAME)
# Gemini keys: https://aistudio.google.com/apikey (free tier needs no billing)
GOOGLE_API_KEY=your_gemini_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Amazon Bedrock (optional) — use with MODEL_NAME=bedrock/...
# See docs/getting-started/bedrock.md for model IDs and auth choices.
# Auth A (quick dev): Bedrock API key (bearer token)
#AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
# Auth B (production/CI): standard AWS credentials (SigV4). SSO users can export
# a session with: eval "$(aws configure export-credentials --profile <p> --format env)"
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
#AWS_REGION_NAME=us-east-1

# Local LLM (optional) - start Ollama with: docker compose --profile local-llm up
# then pull a model (docker compose exec ollama ollama pull llama3.2) and set:
#MODEL_NAME=ollama_chat/llama3.2
# OLLAMA_API_BASE can stay unset: docker-compose.yml passes
# http://ollama:11434 to the agent.

# OpenAI-compatible llama.cpp endpoint (optional).
#LLAMACPP_API_BASE=http://host.docker.internal:18080/v1
#LLAMACPP_API_KEY=not-used
#LLAMACPP_MODEL_NAME=openai/llamacpp
#LLAMACPP_CONTEXT_SIZE=8192

# Context window of the configured model, in tokens. The llama.cpp overlay sets
# this from LLAMACPP_CONTEXT_SIZE; set it directly when pointing MODEL_NAME /
# OPENAI_API_BASE at a self-hosted endpoint without the overlay. Unset means
# LiteLLM's model map, falling back to 128000.
#MODEL_CONTEXT_WINDOW=8192

# ==============================================
# Agent Configuration
# ==============================================
# Set to 'true' to enable Enforcer Mode (forces tool usage, Ulysses Pact)
ENABLE_ENFORCER_MODE=false

# Colon-separated extra skill directories (defaults to agent/skills)
#AGENT_SKILLS_DIRS=/app/skills:/app/provider_skills

# Context harness (docs/architecture/harness_engineering.md). Budgets derive
# from the model's context window (MODEL_CONTEXT_WINDOW or LiteLLM's model map).
#DAK_CONTEXT_HARNESS=true
#DAK_COMPACTION_THRESHOLD_RATIO=0.6   # compact older events past 60% of the window
#DAK_COMPACTION_RETAIN_EVENTS=4       # newest events kept verbatim
#DAK_COMPACTION_INPUT_RATIO=0.5       # history per summary request; the rest is for the summary
#DAK_REQUEST_BUDGET_RATIO=0.85        # last-resort trim of old tool payloads
#DAK_MODEL_ERROR_RETRY_ATTEMPTS=2     # retries (halving the budget) when the model still rejects a request for size
#DAK_TOOL_OUTPUT_MAX_CHARS=           # default: 15% of the window (2K..40K chars)
#DAK_MAX_REPEATED_TOOL_CALLS=3        # same tool + args in a row beyond this is answered with a "repeated_call" observation
#DAK_MAX_TOOL_CALLS=40                # tool calls per invocation beyond this get "step_limit_exceeded"
#DAK_MAX_WALL_SECONDS=300             # tool calls this long after the invocation's first one get "wall_time_exceeded"

# Langfuse Configuration (optional - for monitoring/tracing)
# Get keys from: https://cloud.langfuse.com
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
#LANGFUSE_HOST=https://cloud.langfuse.com

# ==============================================
# AP2 Payment Protocol (Experimental - Solana)
# ==============================================
# Set to 'true' to enable agent-to-agent payment features
ENABLE_AP2_PROTOCOL=false

# Set to 'true' for mock mode (no real transactions; recommended)
SOLANA_USE_MOCK=true

# Solana network: devnet, mainnet, or custom RPC URL
SOLANA_NETWORK=devnet

# Solana private key (base58 or JSON array format)
# Generate with: solana-keygen new
#SOLANA_PRIVATE_KEY=your_solana_private_key

# Custom RPC URL (optional, defaults to public Devnet)
#SOLANA_RPC_URL=https://api.devnet.solana.com

# Payment intent check: block send_sol_payment unless the session's
# user-signed intent (dak:payment_intent) allows it.
# See docs/experimental/solana_integration.md
ENABLE_PAYMENT_INTENT_CHECK=false

# The user's PUBLIC keys as a JWKS JSON string (EC P-256). Never put the
# private key that signs intents here or anywhere in the repository.
#DAK_PAYMENT_INTENT_TRUSTED_JWKS=
